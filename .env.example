# docparse 环境变量样例（复制为 .env 或直接 export；全部变量均有默认值，可不配置）
# 常规调整优先改 config.yaml（优先级：环境变量 > config.yaml > 内置默认值）

# 配置文件路径（缺省依次查找 仓库根/config.yaml、当前目录/config.yaml）
#DOCPARSE_CONFIG=/app/paddle/config.yaml

# ===== 模型路径（宿主机 /data1/models 挂载到容器 /app/models）=====
PPDOCLAYOUT_MODEL_PATH=/app/models/PaddlePaddle/PP-DocLayoutV2
PPDOCLAYOUT_MODEL_NAME=PP-DocLayoutV2
SEAL_DET_MODEL_PATH=/app/models/PaddlePaddle/PP-OCRv4_server_seal_det
SEAL_REC_MODEL_PATH=/app/models/PaddlePaddle/PP-OCRv4_server_rec

# ===== vLLM 服务 =====
VLLM_SERVER_URL=http://localhost:8000/v1
VLLM_MODEL_NAME=PaddleOCR-VL-0.9B
# 以下三项供 scripts/start_vllm.sh 与 docker-compose 健康检查使用
VLLM_MODEL_PATH=/app/models/PaddlePaddle/PaddleOCR-VL
VLLM_PORT=8000
VLLM_MAX_BATCHED_TOKENS=16384

# ===== 输入输出 =====
OUTPUT_DIR=/app/paddle/output
INPUT_PDF_DIR=/app/paddle/input/pdfs

# ===== 运行设备 =====
DOCPARSE_DEVICE=npu

# ===== 测试脚本 =====
DEMO_IMAGE_URL=https://paddle-model-ecology.bj.bcebos.com/paddlex/imgs/demo_image/paddleocr_vl_demo.png
PDF_FILE=
SEAL_IMAGE=https://paddle-model-ecology.bj.bcebos.com/paddlex/imgs/demo_image/seal_text_det.png

# ===== 压测（test/benchmark.py）=====
BENCH_CONCURRENCY=10
BENCH_TOTAL_REQUESTS=50
